{
  "name": "dsh-mayori",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle for persistent, collaborative role-playing games",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./dice": "./src/features/dice/host/plugin.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host",
    "src/shared",
    "src/features/characters/host",
    "src/features/character-session/host",
    "src/features/personas/host",
    "src/features/history/host",
    "src/features/trajectory/host",
    "src/features/dice/host",
    "src/features/character-session/domain",
    "src/features/characters/shared",
    "src/features/dice/shared",
    "src/features/dice/domain",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bundle": "tsdown --config tsdown.config.js",
    "test": "node --test",
    "check": "pnpm run bundle && node --check index.js && node --check src/client/plugin.js && node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitryplyaskin/Mayori.git"
  },
  "homepage": "https://github.com/dmitryplyaskin/Mayori#readme",
  "bugs": {
    "url": "https://github.com/dmitryplyaskin/Mayori/issues"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "role-playing-game",
    "rpg",
    "game-master"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14"
  }
}
