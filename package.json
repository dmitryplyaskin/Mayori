{
  "name": "dsh-mayori",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle for persistent, collaborative role-playing games",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/character-card.js",
    "src/character-library-host.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bundle": "tsdown --config tsdown.config.js",
    "test": "node --test",
    "check": "pnpm run bundle && node --check index.js && node --check src/client.js && node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitryplyaskin/Mayori.git"
  },
  "homepage": "https://github.com/dmitryplyaskin/Mayori#readme",
  "bugs": {
    "url": "https://github.com/dmitryplyaskin/Mayori/issues"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "role-playing-game",
    "rpg",
    "game-master"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  }
}
